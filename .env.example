# Copy this file to .env and adjust values as needed

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production

# Database
# SQLite for development. Swap this single line to a PostgreSQL URI later,
# e.g. postgresql://user:password@localhost:5432/dashen_surveys
DATABASE_URL=sqlite:///dashen_surveys.db

# CORS
FRONTEND_ORIGIN=http://localhost:5173
